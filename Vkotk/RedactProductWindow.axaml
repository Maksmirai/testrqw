<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Vkotk.RedactProductWindow"
        xmlns:local="clr-namespace:Vkotk.Models"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        MinHeight="1080" MinWidth="1920" FontFamily="Comic Sans MS"
        MaxHeight="1080" MaxWidth="1920"
        FontSize="18"  
        Title="Vkotk редактирование продукции"
       >
   
    
            <Grid ShowGridLines="False">
                <Grid.RowDefinitions>
                       <RowDefinition Height="0.7*"></RowDefinition>
                       <RowDefinition Height="*"></RowDefinition>
                       <RowDefinition Height="*"></RowDefinition>
                       <RowDefinition Height="*"></RowDefinition>
                       <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            
            <TextBlock Grid.ColumnSpan="3" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Text="Добавление новой проверки "></TextBlock>
            
            
            
            <StackPanel Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Название продукта"></TextBlock>
                <TextBox Name="TextBoxNameProduct" BorderBrush="MediumBlue"
                         BorderThickness="2" Width="300" Margin="0 10"></TextBox>
            </StackPanel>
            
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"  HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Серийный номер"></TextBlock>
                <TextBox Name="Seriescode" BorderBrush="MediumBlue" Watermark="Не обязательно(если SN есть)"
                         BorderThickness="2" Width="300" Margin="0 10"></TextBox>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Grid.RowSpan="2"  HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Количество продукта"></TextBlock>
                <TextBox Name="CountProduct" BorderBrush="MediumBlue" Watermark="Если не вписывать будет 1"
                         BorderThickness="2" Width="300" Margin="0 10"></TextBox>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Итог проверки"></TextBlock>
                <TextBox Name="CommentProduct" BorderBrush="MediumBlue" Watermark="" TextWrapping="Wrap"
                         BorderThickness="2" Width="300" Height="170" Margin="0 10"></TextBox>
            </StackPanel>
            
            <ListBox Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" BorderBrush="MediumBlue"
                     Background="White" BorderThickness="2"  Margin="20" Name="ListBoxImage">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:Imageproduct">
                                <Border Padding="5">
                                    <Grid>
                                        <Image  Source="{Binding Imageprod}"
                                               Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
           
            </ListBox>
            
                <Button Grid.Row="4" Grid.Column="0"  Background="White"
                        BorderBrush="MediumBlue" BorderThickness="3" Name="ButtonBackMenu" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Content="Вернуться назад" Margin="0 0 30 0"
                        Click="ButtonBackMenu_OnClick"></Button>
                    
                <Button Grid.Row="4" Grid.Column="1"  Background="White"
                        BorderBrush="OrangeRed" BorderThickness="3" Name="ButtonDelProduct" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Content="Удалить запись" Margin="0 0 30 0"
                        Click="ButtonDelProduct_OnClick"></Button>
                    
            <Button Grid.Row="4" Grid.Column="2"  Background="White"
                    BorderBrush="MediumBlue" BorderThickness="3" VerticalAlignment="Top"
                    Content="Добавить новое фото" Margin="20 0 0 0" Name="ButtonAddImage" Click="ButtonAddImage_OnClick"
                    ></Button>
            
            <Button Grid.Row="4" Grid.Column="2"  Background="White"
                    BorderBrush="MediumBlue" BorderThickness="3" Name="ButtonDelImage" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Content="Удалить все фото" Margin="0 0 30 0" Click="ButtonDelImage_OnClick"
                    ></Button>
            
            
            <Button Grid.Row="4" Grid.Column="2" Background="White"
                    BorderBrush="MediumBlue" BorderThickness="3"
                    Content="Редактировать продукт" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Name="ButtonRedact" Click="ButtonRedact_OnClick"></Button>
            
            
        </Grid>
</Window>
